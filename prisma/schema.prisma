generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── المستخدمون ────────────────────────────────────────────────────────────

model User {
  id                 String              @id @default(uuid())
  phone              String              @unique
  email              String?             @unique
  password           String?
  name               String?
  bio                String?
  avatar             String?
  parentPhone        String?             // رقم هاتف ولي الأمر
  governorate        String?             // المحافظة / المدينة
  gradeLevel         String?             // المرحلة الدراسية (ابتدائي / إعدادي / ثانوي)
  gradeName          String?             // اسم الصف الدراسي (مثال: الصف الأول الثانوي)
  role               String              @default("STUDENT") // STUDENT, TEACHER, ADMIN

  // بيانات المعلم / المحاضر وإثبات الهوية
  subjectSpecialty   String?             // المادة الأساسية / التخصص
  teachingStages     String?             // المراحل التي يدرسها (ابتدائي / إعدادي / ثانوي / جامعي)
  jobTitle           String?             // المسمى الوظيفي (معلم أول / خبير / موجه / محاضر)
  yearsOfExperience  String?             // سنوات الخبرة
  whatsappPhone      String?             // رقم الواتساب للتواصل
  nationalId         String?             // الرقم القومي (14 رقم)
  idCardUrl          String?   @db.Text  // رابط أو مسار ملف إثبات الهوية / كارنيه النقابة
  isVerifiedTeacher  Boolean             @default(false) // تم التحقق من المعلم

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  // علاقات المدرس
  subjects           Subject[]           @relation("TeacherSubjects")

  // علاقات الطالب
  classEnrollments   ClassEnrollment[]
  subjectPayments    SubjectPayment[]
  certificates       Certificate[]
  notifications      Notification[]
  subjectAttendances SubjectAttendance[]

  // الموديلات القديمة (للتوافق)
  courses            Course[]            @relation("InstructorCourses")
  enrollments        Enrollment[]
  payments           Payment[]
  reviews            Review[]
  attendances        Attendance[]
}

// ─── الصفوف ────────────────────────────────────────────────────────────────

model Class {
  id           String            @id @default(uuid())
  name         String            // "الصف الأول الابتدائي"
  gradeLevel   String            // "ابتدائي" | "إعدادي" | "ثانوي"
  gradeNumber  Int               // 1-6 ابتدائي | 1-3 إعدادي | 1-3 ثانوي
  section      String?           // "أ" | "ب" | "ج"
  description  String?
  thumbnail    String?
  academicYear String            @default("2025-2026")
  status       String            @default("ACTIVE") // ACTIVE | ARCHIVED
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  subjects     Subject[]
  enrollments  ClassEnrollment[]
}

// ─── تسجيل الطالب في الصف ─────────────────────────────────────────────────

model ClassEnrollment {
  id        String   @id @default(uuid())
  studentId String
  classId   String
  student   User     @relation(fields: [studentId], references: [id])
  class     Class    @relation(fields: [classId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, classId])
}

// ─── المواد ────────────────────────────────────────────────────────────────

model Subject {
  id          String              @id @default(uuid())
  name        String              // "الرياضيات" | "اللغة العربية"
  description String?
  thumbnail   String?
  price       Float               @default(0)  // سعر المادة منفردة
  classId     String
  class       Class               @relation(fields: [classId], references: [id])
  teacherId   String?
  teacher     User?               @relation("TeacherSubjects", fields: [teacherId], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  lectures    SubjectLecture[]
  files       SubjectFile[]
  payments    SubjectPayment[]
  attendances SubjectAttendance[]
}

// ─── دفع المادة ────────────────────────────────────────────────────────────

model SubjectPayment {
  id            String   @id @default(uuid())
  studentId     String
  subjectId     String
  amount        Float
  paymentMethod String   @default("VISA") // VISA | PAYPAL | CASH
  status        String   @default("COMPLETED") // PENDING | COMPLETED | FAILED
  couponCode    String?
  student       User     @relation(fields: [studentId], references: [id])
  subject       Subject  @relation(fields: [subjectId], references: [id])
  createdAt     DateTime @default(now())

  @@unique([studentId, subjectId]) // كل طالب يدفع مادة مرة واحدة
}

// ─── محاضرات المادة ────────────────────────────────────────────────────────

model SubjectLecture {
  id          String              @id @default(uuid())
  title       String
  description String?
  type        String              @default("RECORDED") // LIVE | RECORDED
  liveStatus  String              @default("SCHEDULED") // SCHEDULED | LIVE | ENDED
  videoUrl    String?
  liveUrl     String?             // رابط Zoom أو Meet
  date        DateTime?
  duration    Int                 @default(0) // بالدقائق
  subjectId   String
  subject     Subject             @relation(fields: [subjectId], references: [id])
  createdAt   DateTime            @default(now())

  attendances SubjectAttendance[]
}

// ─── ملفات المادة ──────────────────────────────────────────────────────────

model SubjectFile {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  type       String   // PDF | IMAGE | VIDEO | ZIP
  accessType String   @default("DOWNLOAD") // DOWNLOAD | VIEW_ONLY
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id])
  createdAt  DateTime @default(now())
}

// ─── حضور المحاضرات ────────────────────────────────────────────────────────

model SubjectAttendance {
  id              String         @id @default(uuid())
  studentId       String
  lectureId       String
  subjectId       String
  joinTime        DateTime
  leaveTime       DateTime?
  durationMinutes Int            @default(0)
  percentage      Float          @default(0.0)
  student         User           @relation(fields: [studentId], references: [id])
  lecture         SubjectLecture @relation(fields: [lectureId], references: [id])
  subject         Subject        @relation(fields: [subjectId], references: [id])
  createdAt       DateTime       @default(now())
}

// ─── الشهادات ──────────────────────────────────────────────────────────────

model Certificate {
  id             String   @id @default(uuid())
  studentId      String
  courseName     String?
  subjectName    String?
  instructorName String?
  teacherName    String?
  className      String?
  grade          Float?   // الدرجة
  issuedAt       DateTime @default(now())
  qrCodeUrl      String?
  student        User     @relation(fields: [studentId], references: [id])
}

// ─── الإشعارات ─────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("INFO") // INFO | SUCCESS | WARNING
  isRead    Boolean  @default(false)
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// ─── الموديلات القديمة (للتوافق المؤقت) ──────────────────────────────────

model Course {
  id               String       @id @default(uuid())
  title            String
  description      String
  shortDescription String?
  thumbnail        String?
  instructorId     String
  instructor       User         @relation("InstructorCourses", fields: [instructorId], references: [id])
  startDate        DateTime
  durationWeeks    Int
  totalHours       Int          @default(0)
  maxStudents      Int?
  registrationEnd  DateTime
  price            Float
  refundPolicyDays Int          @default(0)
  status           String       @default("DRAFT")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  lectures         Lecture[]
  enrollments      Enrollment[]
  reviews          Review[]
  files            File[]
  coupons          Coupon[]
  quizzes          Quiz[]
}

model Lecture {
  id          String       @id @default(uuid())
  title       String
  type        String       @default("RECORDED")
  liveStatus  String       @default("SCHEDULED")
  videoUrl    String?
  liveUrl     String?
  date        DateTime?
  courseId    String
  course      Course       @relation(fields: [courseId], references: [id])
  createdAt   DateTime     @default(now())
  attendances Attendance[]
}

model File {
  id         String   @id @default(uuid())
  title      String
  fileUrl    String
  type       String
  accessType String   @default("DOWNLOAD")
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id])
  createdAt  DateTime @default(now())
}

model Enrollment {
  id        String   @id @default(uuid())
  studentId String
  courseId  String
  student   User     @relation(fields: [studentId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])
  createdAt DateTime @default(now())

  @@unique([studentId, courseId])
}

model Payment {
  id            String   @id @default(uuid())
  studentId     String
  student       User     @relation(fields: [studentId], references: [id])
  amount        Float
  paymentMethod String
  status        String
  couponCode    String?
  createdAt     DateTime @default(now())
}

model Quiz {
  id                 String         @id @default(uuid())
  title              String
  startDate          DateTime?
  endDate            DateTime?
  durationMinutes    Int?
  attemptsAllowed    Int            @default(1)
  passingScore       Float          @default(50.0)
  randomizeQuestions Boolean        @default(false)
  showResults        Boolean        @default(true)
  courseId           String
  course             Course         @relation(fields: [courseId], references: [id])
  questions          QuizQuestion[]
  createdAt          DateTime       @default(now())
}

model QuizQuestion {
  id       String   @id @default(uuid())
  quizId   String
  quiz     Quiz     @relation(fields: [quizId], references: [id])
  question String
  type     String   @default("MCQ")
  options  String?
  answer   String
}

model Review {
  id         String   @id @default(uuid())
  studentId  String
  courseId   String
  rating     Int
  comment    String?
  isApproved Boolean  @default(false)
  student    User     @relation(fields: [studentId], references: [id])
  course     Course   @relation(fields: [courseId], references: [id])
  createdAt  DateTime @default(now())
}

model Coupon {
  id         String    @id @default(uuid())
  code       String    @unique
  type       String
  value      Float
  expiryDate DateTime?
  maxUses    Int?
  usesCount  Int       @default(0)
  courseId   String?
  course     Course?   @relation(fields: [courseId], references: [id])
  createdAt  DateTime  @default(now())
}

model Attendance {
  id              String   @id @default(uuid())
  studentId       String
  lectureId       String
  joinTime        DateTime
  leaveTime       DateTime?
  durationMinutes Int      @default(0)
  percentage      Float    @default(0.0)
  student         User     @relation(fields: [studentId], references: [id])
  lecture         Lecture  @relation(fields: [lectureId], references: [id])
  createdAt       DateTime @default(now())
}
